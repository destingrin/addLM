# Normalise line endings: store LF in the repository, check out with the
# platform's native endings.
* text=auto

# Windows scripts must keep CRLF in the working tree. A .bat file with LF-only
# endings can misbehave, and the launcher is the project's entry point.
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary assets - never touched.
*.parquet binary
*.png binary
